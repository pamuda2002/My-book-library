<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book Note</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    
    <form class="form-input" action="/update" method="POST">
        <h1>Edit Book Note</h1>
        <br>
        <input type="hidden" name="bookId" value="<%= book.id %>">
        
        <label>Title:</label>
        <input type="text" name="title" value="<%= book.title %>" required>

        <label>Author:</label>
        <input type="text" name="author" value="<%= book.author %>">

        <label>ISBN:</label>
        <input type="text" name="isbn" value="<%= book.isbn %>">

        <label>Rating (1-10):</label>
        <input type="number" name="rating" value="<%= book.rating %>" min="1" max="10">

        <label>Date Read:</label>
        <input type="date" name="date_read" value="<%= book.date_read.toISOString().split('T')[0] %>">

        <label>My Notes:</label>
        <textarea name="notes" rows="5"><%= book.notes %></textarea>
        
        <a class="edit-cancel" href="/">Cancel</a>
        <button class="input-btn" type="submit">Save Changes</button>
    </form>

    
    
</body>
</html>