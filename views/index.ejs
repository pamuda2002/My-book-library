<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Book Library</title>
</head>
<body>
    <h1>My Book Note</h1>
    <a href="/new">Add a New Book</a> <hr>
    
    <div class="book-list">
        <% if (locals.books && books.length > 0) { %>
            <% books.forEach(book => { %>
                <div class="book-card">
                    <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg" alt="Cover of <%= book.title %>">

                    <h2><%= book.title %></h2>
                    <p>By: <%= book.author %></p>
                    <p>Rating: <%= book.rating %>/5</p>
                    <p>Read on: <%= new Date(book.date_read).toLocaleDateString()%></p>
                    <blockquote>
                        <p><%= book.notes %></p>
                    </blockquote>
                </div>

                <a href="/edit/<%= book.id %>">Edit</a>
                
                <form action="/delete" method="POST">
                    <input type="hidden" name="bookID" value="<%= book.id %>">
                    <button type="submit">Delete</button>
                </form>
            <% }); %>
        <% } else { %>
            <p>No books added yet. <a href="/new">Add one!</a></p>
        <% } %>
    </div>
</body>
</html>